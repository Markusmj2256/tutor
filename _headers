# Cloudflare Pages læser denne fil. Vercel og GitHub Pages ignorerer den,
# så den kan ligge i repoet uanset hvor siden hostes.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Cross-Origin-Opener-Policy: same-origin

# Fonte og fotos har indhold, der aldrig ændrer sig under samme filnavn.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/photos/*
  Cache-Control: public, max-age=31536000, immutable

# Admin-siden må aldrig mellemlagres eller vises i en ramme.
/admin
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/admin.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

# Kundesiden og dens backend viser personoplysninger om elever: aldrig
# mellemlagring, aldrig i søgeresultater, og ingen henvisningsadresse ud af siden.
/forloeb
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer

/forloeb.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer

/forloeb-admin
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/forloeb-admin.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

# Kun Cloudflares alternative adresse skal udelukkes fra søgeresultater.
https://lokaltutor.pages.dev/*
  X-Robots-Tag: noindex
